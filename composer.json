{
    "name": "webconsulting/webcon-easy-workspace",
    "description": "Easy Workspace — a backend toolbar item for TYPO3 v14 that lets editors publish the current page (or news record) together with its content elements in one click.",
    "license": "GPL-2.0-or-later",
    "type": "typo3-cms-extension",
    "keywords": [
        "TYPO3",
        "workspaces",
        "publishing",
        "backend",
        "toolbar"
    ],
    "authors": [
        {
            "name": "webconsulting",
            "homepage": "https://webconsulting.at",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/dirnbauer/typo3-webcon-easy-workspace",
    "support": {
        "issues": "https://github.com/dirnbauer/typo3-webcon-easy-workspace/issues",
        "source": "https://github.com/dirnbauer/typo3-webcon-easy-workspace"
    },
    "require": {
        "php": "^8.2",
        "typo3/cms-backend": "^14.3",
        "typo3/cms-core": "^14.3",
        "typo3/cms-fluid": "^14.3",
        "typo3/cms-frontend": "^14.3",
        "typo3/cms-workspaces": "^14.3"
    },
    "require-dev": {
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "saschaegerer/phpstan-typo3": "^3.0.1"
    },
    "suggest": {
        "georgringer/news": "Adds news-bundle publishing (news record + content elements via tx_news_related_news).",
        "friendsoftypo3/visual-editor": "Enables the per-row eye icon to scroll & outline a content element inside the Visual Editor iframe. The dropdown works without it; the eye gracefully falls back to typo3/cms-viewpage's preview iframe."
    },
    "autoload": {
        "psr-4": {
            "Webconsulting\\WebconEasyWorkspace\\": "Classes/"
        }
    },
    "scripts": {
        "lint": "find Classes Configuration -name '*.php' -print0 | xargs -0 -n1 php -l",
        "phpstan": "phpstan analyse --configuration=Build/phpstan/phpstan.neon --memory-limit=1G",
        "test": [
            "@lint",
            "@phpstan"
        ]
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "sort-packages": true
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "webcon_easy_workspace",
            "version": "1.0.3",
            "Package": {
                "providesPackages": {}
            }
        }
    }
}
