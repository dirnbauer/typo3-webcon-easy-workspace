parameters:
  level: max
  phpVersion: 80200

  paths:
    - ../../Classes
    - ../../Configuration

  tmpDir: .cache/phpstan/

  excludePaths:
    - '**/node_modules/*'
    - '**/ext_emconf.php'

  treatPhpDocTypesAsCertain: false
  checkMissingOverrideMethodAttribute: false

  typo3:
    containerXmlPath: null
