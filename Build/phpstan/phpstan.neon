parameters:
  level: 8
  phpVersion: 80400

  paths:
    - ../../Classes
    - ../../Configuration
    - ../../Tests
    - ../../Extensions/webcon_workspace_chatops/Classes
    - ../../Extensions/webcon_workspace_chatops/Configuration
    - ../../Extensions/webcon_workspace_chatops/ext_localconf.php

  tmpDir: .cache/phpstan/

  excludePaths:
    - '**/node_modules/*'

  treatPhpDocTypesAsCertain: false
  checkMissingOverrideMethodAttribute: false

  typo3:
    containerXmlPath: null
    requestGetAttributeMapping:
      backend.user: TYPO3\CMS\Core\Authentication\BackendUserAuthentication|null
