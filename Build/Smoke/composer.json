{
    "name": "webconsulting/easy-workspace-smoke",
    "description": "Disposable TYPO3 host for testing the extension checkout.",
    "license": "GPL-2.0-or-later",
    "type": "project",
    "repositories": [{"type": "path", "url": "../.."}],
    "require": {
        "typo3/cms-fluid-styled-content": "^14.3.6",
        "typo3/cms-install": "^14.3.6",
        "typo3/cms-rte-ckeditor": "^14.3.6",
        "typo3/cms-viewpage": "^14.3.6",
        "webconsulting/webcon-easy-workspace": "dev-main"
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "extra": {"typo3/cms": {"web-dir": "public"}}
}
