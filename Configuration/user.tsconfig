# =============================================================
# Easy Workspace — default User TSconfig
#
# This file is auto-loaded by TYPO3 v14 from
# EXT:webcon_easy_workspace/Configuration/user.tsconfig
# and applies to every backend user unless explicitly overridden
# at user / group / page level.
#
# Override precedence (highest wins):
#   Page TSconfig at the current page
#   User TSconfig on the user record
#   User TSconfig on the user's group
#   These defaults
#
# All boolean keys take 1 (on) or 0 (off). Defaults are ON so a
# fresh install gives editors the full feature set; switch a key
# to 0 when a role doesn't need it.
# =============================================================

options.webcon_easy_workspace {

    # -- Master ---------------------------------------------------

    # 0 hides the toolbar item entirely. The AJAX endpoints also
    # respond with 403 so the feature is gone in any context. (1)
    enabled = 1

    # -- Header ---------------------------------------------------

    # Show the active workspace name (e.g. "Staging") as a chip
    # next to "Workspace publish". (1)
    enableWorkspaceChip = 1

    # Show the "Preview link" button in the dropdown header. Clicking
    # it copies a workspace preview URL — built by TYPO3's
    # \TYPO3\CMS\Workspaces\Preview\PreviewUriBuilder — to the OS
    # clipboard. (1)
    enablePreviewLink = 1

    # -- List filter ---------------------------------------------

    # Show the filter chip row ("To publish" / "All on page").
    # When 0, the dropdown always shows changes only. (1)
    enableFilter = 1

    # Default filter mode when the dropdown opens.
    # Allowed: changed | all. (changed)
    defaultMode = changed

    # -- List rendering ------------------------------------------

    # Resolve and render the first-image thumbnail of each row
    # (looked up from sys_file_reference on a small allow-list of
    # fields: tt_content.image, tt_content.assets, tt_content.media,
    # pages.media, tx_news.fal_media …). (1)
    enableThumbnails = 1

    # Show the second meta line ("Page · Blog Post" /
    # "Page Content · Text & Images"). Both labels come from the
    # current backend language. (1)
    enableTypeLabels = 1

    # Show the "Hidden" badge next to the state badge on records
    # whose hidden=1. The diagonal-stripe thumbnail overlay also
    # depends on this flag. (1)
    enableHiddenBadge = 1

    # When 0, hidden records are filtered out *server-side* — they
    # never reach the response payload. Combine with
    # enableHiddenBadge to control how visible hidden state is. (1)
    showHidden = 1

    # Hard cap on rows fetched per request — never grow unbounded
    # on huge pages. (200)
    maxItems = 200

    # -- Aggregation scope ---------------------------------------

    # In addition to the page's own tt_content, also list every
    # news record stored on the same page (tx_news_domain_model_news
    # where pid = currentPage) and recursively include its linked
    # tt_content via tx_news_related_news. Has no effect when
    # EXT:news is not installed. (1)
    enableNewsBundles = 1

    # -- Per-row actions -----------------------------------------

    # Show the eye icon on every tt_content row. Hovering / clicking
    # the eye reaches into the Visual Editor iframe
    # (#visual-editor-iframe), scrolls the rendered content element
    # into view and outlines it. (1)
    enableHoverHighlight = 1

    # Show the curved-arrow discard button on every changed row.
    # Clicking triggers a warning confirmation modal, then runs the
    # v14-canonical DataHandler command
    #   $cmd[$table][$workspaceUid]['version'] = ['action' => 'flush'];
    # which removes the workspace version. The live record stays
    # untouched. TYPO3 calls this operation "discard". (1)
    enableRevert = 1
}
